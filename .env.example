# ============================================================
# Variables d'environnement — A configurer sur Vercel
# (Project Settings > Environment Variables)
# Ne JAMAIS commiter le vrai fichier .env : il est ignore par git.
# ============================================================

# --- Cles VAPID (generees avec : npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=colle_ici_la_cle_publique
VAPID_PRIVATE_KEY=colle_ici_la_cle_privee
VAPID_SUBJECT=mailto:alexandre.giron11@gmail.com

# --- Upstash Redis (tableau de bord Upstash > onglet REST) ---
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=colle_ici_le_token_REST

# --- Secret protegeant /api/tick (chaine aleatoire de ton choix) ---
# Exemple pour en generer une : openssl rand -hex 24
CRON_SECRET=mets_ici_une_longue_chaine_aleatoire
